{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "debugpy",
            "name": "🐍 Launch Backend",
            "request": "launch",
            "program": "${workspaceFolder}/backend/run.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/.env",
            "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe"
        },
        {
            "name": "🌐 Launch Frontend",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/frontend"
        },
        {
            "type": "debugpy",
            "name": "🤖 Launch Scraper",
            "request": "launch",
            "program": "${workspaceFolder}/scraper/windows/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/scraper/windows",
            "envFile": "${workspaceFolder}/scraper/windows/.env",
            "python": "${workspaceFolder}/scraper/windows/.venv/Scripts/python.exe"
        }
    ]
}
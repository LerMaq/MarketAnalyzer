{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "debugpy",
            "name": "backend",
            "request": "launch",
            "program": "${workspaceFolder}/backend/run.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/.env",
            "purpose": [
                "debug-test"
            ]
        },
        {
            "name": "frontend",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/frontend"
        }
    ]
}
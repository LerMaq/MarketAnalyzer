########################################
#          Required Parameters         #
########################################

# Адрес API, например: https://lermak.dns.navy/api
# Для докера локально: http://host.docker.internal:8000
BASE_URL=change_me

# Токен воркера. Создаётся в админ-панели
WORKER_TOKEN=change_me

# Пароль от VNC. Используется только если VNC_ENABLED=true
VNC_PASSWORD=change_me

########################################
#           General Settings           #
########################################

# HTTP-заголовок для авторизации воркера
WORKER_AUTH_HEADER=X-Worker-Token

# Проверять ли TLS-сертификат backend
BACKEND_SSL_VERIFY=true

# Общий timeout HTTP-запросов к backend (необходимо для Long Polling)
HTTP_TIMEOUT_SEC=60

# Timeout на установку соединения с backend
HTTP_CONNECT_TIMEOUT_SEC=15

# Минимальное и максимальное количество Enter в поиске (защита от бесконечного поиска)
FIND_MIN_ITERATIONS=20
FIND_MAX_ITERATIONS=250

########################################
#  Entrypoint (Virtual Display & VNC)  #
########################################

# Номер виртуального дисплея X11
DISPLAY=:99

# Разрешение виртуального дисплея
SCREEN_WIDTH=1280
SCREEN_HEIGHT=720
SCREEN_DEPTH=24

# VNC нужен для наблюдения за браузером и управлением им вручную:
# Для безопасности лучше false. VNC нельзя открывать напрямую в интернет
# Для отладки можно поставить true
VNC_ENABLED=false

# Порт VNC внутри контейнера
VNC_PORT=5901

########################################
#          PyAutoGUI Settings          #
########################################

# Пауза между всеми действиями в PyAutoGUI
PYAUTOGUI_PAUSE_SEC=0.01

########################################
#          Main Loop Settings          #
########################################

# Пауза после успешной обработки задачи перед запросом следующей
TASK_POLL_INTERVAL_SEC=2

# Пауза, если backend вернул нет задач (ответ от бэкэнда приходит до 45 секунд)
NO_TASK_SLEEP_SEC=2

# Пауза после любой ошибки в главном цикле
ERROR_RETRY_INTERVAL_SEC=5

# Сколько раз пытаться отправить результат задачи на backend
COMPLETE_RETRIES=5

########################################
#        Browser Initialization        #
########################################

# Исполняемый файл Firefox внутри контейнера
FIREFOX_BIN=firefox-esr

# Путь к профилю Firefox внутри контейнера
FIREFOX_PROFILE_DIR=/tmp/firefox-profile

# Сколько ждать после запуска Firefox
# Если браузер не успевает стартовать — увеличить
BROWSER_STARTUP_WAIT_SEC=35

########################################
#          Product Scraping            #
########################################

# Сначала активируется окно Firefox
# Пауза после выполнения активвации окна
WINDOW_ACTIVATE_WAIT_SEC=1.0

# Пауза после открытия новой вкладки
NEW_TAB_WAIT_SEC=1

# Пауза после вставки ссылки на товар в поисковую строку
URL_PASTE_WAIT_SEC=0.3

# Первичное ожидание загрузки страницы товара после Enter
PAGE_INITIAL_LOAD_WAIT_SEC=5

# Прокрутка к рекомендациям (3-4 pgdn с интервалом 0.3 сек)
RECOMMENDATIONS_PAGEDOWN_COUNT=4
RECOMMENDATIONS_PAGEDOWN_INTERVAL_SEC=0.3
# Ожидание после прокрутки к рекомендациям, чтобы страница догрузилась
AFTER_RECOMMENDATIONS_WAIT_SEC=5

# Прокрутка к отзывам (6 pgdn с интервалом 1.4 сек)
REVIEWS_PAGEDOWN_COUNT=6
REVIEWS_PAGEDOWN_INTERVAL_SEC=1.4

# Пауза после открытия диалога поиска.
FIND_DIALOG_OPEN_WAIT_SEC=0.5
REVIEW_SEARCH_TEXT='Вам помог'

# Пауза после записи в clipboard.
CLIPBOARD_SETTLE_WAIT_SEC=0.2
# Пауза после вставки в поиск
FIND_DIALOG_AFTER_PASTE_WAIT_SEC=0.2

# Поиск отзывов по странице (интервал между нажатием Enter)
FIND_ITERATION_INTERVAL_SEC=0.3

# Пауза после закрытия диалога поиска
FIND_DIALOG_CLOSE_WAIT_SEC=0.3

# Время ожидания открытия DevTools
DEVTOOLS_OPEN_WAIT_SEC=3

# Количество открытий комментариев
COMMENTS_CLICK_MAX_LIMIT=15
# Интервал между открытиями комментариев в JS
COMMENTS_CLICK_INTERVAL_SEC=0.5

# Пауза после вставки команды в devtools.
DEVTOOLS_AFTER_PASTE_WAIT_SEC=0.5

# Пауза после нажатия Enter (отправка команды) и закрытия devtools
DEVTOOLS_AFTER_ENTER_WAIT_SEC=1.0
DEVTOOLS_CLOSE_WAIT_SEC=3

# Нажали ctrl + a. Нужно подождать, пока всё выделится
BEFORE_CAPTURE_WAIT_SEC=1

# Пауза после нажатия ctrl + c
CAPTURE_WAIT_SEC=2

# Пауза после закрытия вкладки
AFTER_TAB_CLOSE_WAIT_SEC=0.5